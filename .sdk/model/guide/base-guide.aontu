# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 6
  metrics: count: path: 7
  metrics: count: method: 7

  entity: board: {
    path: "/job-boards/{company}/board": {
      op: list: method: *GET
      op: list: transform: res: *("`body.jobs`")|top
    }
  }

  entity: facet: {
    path: "/job-boards/{company}/facets": {
      op: load: method: *GET
    }
  }

  entity: health: {
    path: "/health": {
      op: load: method: *GET
    }
  }

  entity: job: {
    path: "/job-boards/{company}/jobs": {
      op: list: method: *GET
      op: list: transform: res: *("`body.data`")|top
    }
    path: "/job-boards/{company}/jobs/{idOrSlug}": {
      rename: param: "idOrSlug": *"id"
      op: load: method: *GET
      op: load: transform: res: *("`body.job`")|top
    }
  }

  entity: job_posting: {
    path: "/job-boards/{company}/jobs/{idOrSlug}/json-ld": {
      rename: param: "idOrSlug": *"id_or_slug"
      op: list: method: *GET
    }
  }

  entity: organization: {
    path: "/job-boards/{company}": {
      op: load: method: *GET
      op: load: transform: res: *("`body.organization`")|top
    }
  }

}